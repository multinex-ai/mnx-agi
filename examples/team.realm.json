{
  "apiVersion": "mnx-agi/v0.1",
  "kind": "Realm",
  "metadata": {
    "id": "example-team",
    "displayName": "Example team realm"
  },
  "spec": {
    "profile": "portable",
    "policyPath": ".realm/policy.md",
    "memory": {
      "adapter": "memq",
      "mode": "preferred",
      "expectedNamespace": "example-team-scope",
      "onUnavailable": "local-only",
      "identityRef": "identity:synthetic-team-binding"
    },
    "coordination": {
      "coordinator": "external-verified",
      "maxWorkers": 3
    },
    "federation": {
      "mode": "isolated",
      "peers": []
    },
    "decisionRouting": {
      "enabled": false
    },
    "skills": [
      "mnx-realm-context",
      "mnx-memq-recall",
      "mnx-memq-checkpoint",
      "mnx-memq-coordinate"
    ],
    "budgets": {
      "contextTokens": 12000,
      "maxToolCalls": 80,
      "maxDelegationDepth": 1
    }
  }
}
