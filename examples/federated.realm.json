{
  "apiVersion": "mnx-agi/v0.1",
  "kind": "Realm",
  "metadata": {
    "id": "example-source",
    "displayName": "Example federated source"
  },
  "spec": {
    "profile": "portable",
    "policyPath": ".realm/policy.md",
    "memory": {
      "adapter": "memq",
      "mode": "preferred",
      "expectedNamespace": "example-source-scope",
      "onUnavailable": "local-only",
      "identityRef": "identity:synthetic-team-binding"
    },
    "coordination": {
      "coordinator": "external-verified",
      "maxWorkers": 3
    },
    "federation": {
      "mode": "explicit-grants",
      "peers": [
        {
          "realmId": "example-peer",
          "grantRef": "grant:synthetic-review-only",
          "operations": [
            "query",
            "export"
          ],
          "dataClasses": [
            "approved-shared"
          ]
        }
      ]
    },
    "decisionRouting": {
      "enabled": false
    },
    "skills": [
      "mnx-realm-context",
      "mnx-memq-recall",
      "mnx-memq-checkpoint",
      "mnx-memq-coordinate",
      "mnx-realm-federation"
    ],
    "budgets": {
      "contextTokens": 12000,
      "maxToolCalls": 80,
      "maxDelegationDepth": 1
    }
  }
}
