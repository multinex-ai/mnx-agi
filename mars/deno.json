{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "test": "deno test --allow-run --allow-read --allow-env --allow-net=127.0.0.1",
    "check": "deno check src/**/*.ts tests/**/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "lint": {
    "exclude": ["tests/fixtures"],
    "rules": { "exclude": ["require-await"] }
  },
  "fmt": { "lineWidth": 120 }
}
