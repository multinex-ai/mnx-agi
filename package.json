{
  "name": "@multinex-ai/mnx-agi",
  "version": "1.4.0-rc.1",
  "description": "MNX-AGI: a model-agnostic recursive agent harness paired with MemQ by Multinex. Plan, act, verify and resume with saved context across compatible agents and authorized sessions.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mnx-agi": "bin/mnx-agi.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:broker": "python3 -B -m unittest discover -s broker -p 'test_*.py' -v",
    "manifest": "node tools/build-manifest.mjs",
    "check": "node tools/check-release.mjs && node bin/mnx-agi.mjs verify-package",
    "prepack": "npm test && npm run check",
    "check:public": "node tools/check-release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/multinex-ai/mnx-agi.git"
  }
}
